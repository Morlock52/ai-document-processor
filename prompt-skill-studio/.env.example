# --- Studio core ---
# Shared passcode for /login. Anyone with this can author + run.
STUDIO_PASSCODE=change-me

# 32-byte base64 master key for AES-256-GCM key wrapping.
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
STUDIO_MASTER_KEY=

# Iron-session-style cookie secret (32+ random bytes, base64).
SESSION_SECRET=

# --- Database ---
DATABASE_URL=postgresql+psycopg://studio:studio@db:5432/studio

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS / front-end URL ---
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Doc sync ---
# Override or extend the default poll list with a comma-separated list.
# DOC_SYNC_EXTRA_SOURCES=

# --- Optional: vendor keys for the cron health-check user (leave blank in prod) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
