# ==============================================================================
# AI Document Processor - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Selection (2025 recommended models)
# - gpt-4o: Best for document processing with vision (default, recommended)
# - gpt-4o-mini: Cost-effective alternative (87% cheaper)
# - gpt-4.1: Better for text/coding tasks
OPENAI_MODEL=gpt-4o

# Security Secret Key (IMPORTANT: Generate a secure random key!)
# Generate with: openssl rand -hex 32
# Or: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-at-least-32-characters-long

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# AWS S3 Storage (Optional - for production file storage)
# If not set, files will be stored locally
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=document-processor
AWS_REGION=us-east-1

# ==============================================================================
# SERVICE PORTS (Advanced - only change if needed)
# ==============================================================================

# Frontend port (external)
# FRONTEND_PORT=3005

# Backend API port (external)
# BACKEND_PORT=8005

# PostgreSQL port (external)
# POSTGRES_PORT=5434

# Redis port (external)
# REDIS_PORT=6379

# ==============================================================================
# DATABASE CONFIGURATION (Auto-configured for Docker)
# ==============================================================================
# These are automatically set in docker-compose.yml
# Only modify if running outside Docker

# DATABASE_URL=postgresql://docuser:docpass@localhost:5432/docprocessor
# REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. OpenAI Model Pricing (as of 2025):
#    - gpt-4o: $5 per 1M input tokens, $15 per 1M output tokens
#    - gpt-4o-mini: $0.15 per 1M input tokens, $0.60 per 1M output tokens
#
# 2. For development/testing, use gpt-4o-mini to reduce costs
#
# 3. SECRET_KEY must be kept secure and never committed to version control
#
# 4. For detailed setup instructions, see: DOCKER_SETUP.md
#
# ==============================================================================
